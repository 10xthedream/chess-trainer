# Copy this file to .env and fill in real values. .env is gitignored.

CHESSCOM_USERNAME=
# Chess.com asks API clients to put a contact email in the User-Agent so they
# can reach you if your script misbehaves, instead of just blocking you.
CHESSCOM_CONTACT_EMAIL=

# Full path to the Stockfish binary, e.g. C:\stockfish\stockfish-windows-x86-64-avx2.exe
STOCKFISH_PATH=

# Which chess.com time class to analyze: rapid | blitz | bullet | daily
TIME_CLASS=rapid

# Fixed node budget per position for Stockfish analysis. ~1,000,000 is a good
# default for 700-level play (deep enough to catch tactics, fast enough to
# chew through hundreds of games).
STOCKFISH_NODES=1000000
# CPU threads Stockfish uses per position. Set to your physical core count
# (leave 1-2 free for the OS), e.g. 6 on a 6-core/12-thread CPU.
STOCKFISH_THREADS=1

# SQLite database file (created on first run).
DB_PATH=chess_trainer.db

# Where to write the weekly markdown report.
OBSIDIAN_VAULT_PATH=G:\My Drive\Claude Code\obsidian-vault
